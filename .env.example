# ============================================================
# GreenGrow — Variables d'environnement
# Copie ce fichier en .env et remplis tes valeurs
# NE JAMAIS committer .env dans Git
# ============================================================

# Application
APP_NAME=GreenGrow
APP_ENV=development
DEBUG=True

# Base de données (SQLite en dev, PostgreSQL en prod)
DATABASE_URL=sqlite:///./greengrow_dev.db

# Sécurité API (génère une clé aléatoire : python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_MOI_EN_PROD

# MQTT (broker messages capteurs)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_SENSORS=greengrow/sensors/#
MQTT_TOPIC_ALERTS=greengrow/alerts

# Seuils capteurs tomate (modifiables selon saison)
MOISTURE_THRESHOLD_LOW=45
MOISTURE_THRESHOLD_HIGH=80
TEMP_MAX_CELSIUS=35

# IA
AI_MODEL_PATH=ai/models/tomato_disease_v1.tflite
AI_CONFIDENCE_THRESHOLD=0.75
AI_CAPTURE_INTERVAL_HOURS=6
