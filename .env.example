# ============================================================
# GreenGrow — Variables d'environnement
# Copie ce fichier en .env et remplis tes valeurs
# NE JAMAIS committer .env dans Git
# ============================================================

# Application
APP_NAME=GreenGrow
APP_ENV=development
DEBUG=True

# Sites web autorisés à appeler l'API depuis un navigateur (séparés par des virgules)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Base de données (SQLite en dev, PostgreSQL en prod)
DATABASE_URL=sqlite:///./greengrow_dev.db

# ---- Connexion des utilisateurs ----
# Les comptes se créent avec : python scripts/create_user.py --email ... --role owner
# Durée d'une connexion, en heures (168 = 7 jours)
SESSION_HOURS=168
# Mots de passe faux tolérés par compte avant blocage, et durée du blocage
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15

# ---- Commandes envoyées aux bacs ----
# Une commande non exécutée après ce délai (secondes) est ignorée par le bac
COMMAND_LIFETIME_SECONDS=30

# ---- Alertes Telegram (facultatif, voir docs/etape-4b-dashboard.md) ----
# Jeton donné par @BotFather. C'est un secret : ne le partage pas.
TELEGRAM_BOT_TOKEN=
# Identifiant de ta conversation avec le bot : python scripts/telegram_setup.py
TELEGRAM_CHAT_ID=

# ---- MQTT (broker Mosquitto, voir docker-compose.yml) ----
MQTT_ENABLED=true
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_CA_FILE=certs/ca.crt
# Compte administrateur du broker : ne sert qu'à créer les comptes. Choisis un mot de passe long.
# Il est fixé au PREMIER démarrage du broker ; pour le changer ensuite : docker compose down -v
MQTT_ADMIN_USER=admin
MQTT_ADMIN_PASSWORD=
# Compte du backend (lecture des mesures, envoi des commandes)
MQTT_BACKEND_USER=greengrow-backend
MQTT_BACKEND_PASSWORD=

# Seuils par défaut d'un nouveau bac (profil tomate). Chaque bac garde ensuite ses propres seuils en base.
MOISTURE_THRESHOLD_LOW=45
MOISTURE_THRESHOLD_HIGH=80
TEMP_MAX_CELSIUS=35

# IA
AI_MODEL_PATH=ai/models/tomato_disease_v1.tflite
AI_CONFIDENCE_THRESHOLD=0.75
AI_CAPTURE_INTERVAL_HOURS=6
